<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoanCalculator.Pages.TemperaturePage"
             Title="Temperature Converter"
             BackgroundColor="#1E1E2E">

    <VerticalStackLayout Padding="25" Spacing="20" VerticalOptions="Center">

        <Label Text="Temperature Converter"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center" />

        <Frame BackgroundColor="#2A2A3C" CornerRadius="15" Padding="20" HasShadow="True">
            <VerticalStackLayout Spacing="15">

                <Label Text="Enter Temperature" TextColor="#AAAAAA" FontSize="14"/>
                <Entry x:Name="TempEntry"
                       Placeholder="e.g. 25"
                       Keyboard="Numeric"
                       TextColor="White"
                       BackgroundColor="#3A3A4C"
                       PlaceholderColor="#777777"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="°C → °F"
                            Clicked="OnCtoFClicked"
                            BackgroundColor="#4ECDC4"
                            TextColor="Black"
                            CornerRadius="10"
                            WidthRequest="130"/>
                    <Button Text="°F → °C"
                            Clicked="OnFtoCClicked"
                            BackgroundColor="#FF6B6B"
                            TextColor="White"
                            CornerRadius="10"
                            WidthRequest="130"/>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#444" Margin="0,10"/>

                <Label x:Name="ResultLabel"
                       Text="Result will appear here"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#4ECDC4"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>