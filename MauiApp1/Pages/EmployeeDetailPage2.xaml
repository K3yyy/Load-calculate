<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Pages.EmployeeDetailPage2"
             x:DataType="vm:EmployeeDetailViewModels2"
             Title="Employee Details">
    <TableView Intent="Data">
        <TableRoot>
            <TableSection Title="Basic Information">
                <TextCell Text="Employee ID" Detail="{Binding EmployeeId}"/>
                <EntryCell Text="{Binding EmployeeId}"/>
                <TextCell Text="Name" Detail="{Binding EmployeeName}"/>
                <EntryCell Text="{Binding EmployeeName}"/>
                <TextCell Text="Email" Detail="{Binding Email}"/>
                <EntryCell Text="{Binding Email}"/>
                <SwitchCell Text="Is Part-Time" On="{Binding IsPartTime}"/>
            </TableSection>
        </TableRoot>
    </TableView>
</ContentPage>