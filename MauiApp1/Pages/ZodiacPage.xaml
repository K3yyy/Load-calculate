<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.ZodiacPage"
             Title="Zodiac Luck"
             BackgroundColor="#1E1E2E">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label Text="🔮 Zodiac &amp; Birthstone Luck"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

            <Label Text="Enter your phone number"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"/>

            <Entry x:Name="PhoneEntry"
                   Placeholder="e.g. 0812345678"
                   Keyboard="Telephone"
                   TextColor="White"
                   BackgroundColor="#3A3A4C"
                   PlaceholderColor="#777777"
                   MaxLength="15"/>

            <Button Text="Reveal My Luck"
                    Clicked="OnRevealClicked"
                    BackgroundColor="#9B59B6"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

            <Frame x:Name="ResultFrame"
                   IsVisible="False"
                   BackgroundColor="#2A2A3C"
                   CornerRadius="18"
                   Padding="25"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="ZodiacLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#F1C40F"
                           HorizontalOptions="Center"/>
                    <Label x:Name="BirthstoneLabel"
                           FontSize="20"
                           TextColor="#E74C3C"
                           HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" Color="#555" Margin="0,5"/>
                    <Label x:Name="LuckLabel"
                           FontSize="16"
                           TextColor="#ECF0F1"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>