<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoanCalculator.MainPage"
             Title="Khoeun Sarom Saronald (0015735)"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- Title -->
            <Label Text="Loan Calculator"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1A1A1A"
                   Margin="0,10,0,20"/>

            <!-- Loan Amount -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Label Text="Loan Amount"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="#333"/>
                <Entry x:Name="LoanAmountEntry"
                       Grid.Column="1"
                       Keyboard="Numeric"
                       Placeholder="0"
                       Text="1780"
                       FontSize="16"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <!-- Interest Rate -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Label Text="Interest Rate (%)"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="#333"/>
                <Entry x:Name="InterestRateEntry"
                       Grid.Column="1"
                       Keyboard="Numeric"
                       Placeholder="0"
                       Text="1"
                       FontSize="16"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <!-- Loan Term -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Label Text="Loan Term (Years)"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="#333"/>
                <Entry x:Name="LoanTermEntry"
                       Grid.Column="1"
                       Keyboard="Numeric"
                       Placeholder="0"
                       Text="5"
                       FontSize="16"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <!-- Calculate Button -->
            <Button Text="Calculate"
                    BackgroundColor="#6B3FA0"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8"
                    Margin="0,15,0,20"
                    Clicked="OnCalculateClicked"/>

            <!-- Results -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Monthly Payment"
                           FontSize="16"
                           TextColor="#333"/>
                    <Label x:Name="MonthlyPaymentLabel"
                           Grid.Column="1"
                           Text="$0.00"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1A1A1A"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total Interest"
                           FontSize="16"
                           TextColor="#333"/>
                    <Label x:Name="TotalInterestLabel"
                           Grid.Column="1"
                           Text="$0.00"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1A1A1A"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total Payment"
                           FontSize="16"
                           TextColor="#333"/>
                    <Label x:Name="TotalPaymentLabel"
                           Grid.Column="1"
                           Text="$0.00"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1A1A1A"/>
                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>